<Window x:Class="PhoneAudioBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="手机音频桥"
        Width="404"
        SizeToContent="Height"
        MaxHeight="740"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#F7F8FA" BorderBrush="#DFE3E8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= 自绘标题栏 ================= -->
            <Grid Grid.Row="0" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                        Background="{StaticResource AccentBrush}" Margin="14,0,9,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1" Text="手机音频桥" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" />
                    <Button x:Name="CloseButton" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0"
                          MaxHeight="680">
                <StackPanel Margin="14,14,14,16">

                    <!-- 状态卡 -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="9" Height="9"
                                         Fill="{StaticResource IdleBrush}" VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                                <TextBlock x:Name="StateTitle" Text="未连接" FontSize="17.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="StateSubtitle" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="17,7,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="选择下面列出的手机，把它的声音接到这台电脑播放。" />

                            <Border x:Name="SilentHint" Visibility="Collapsed" Background="#FFF8EC"
                                    BorderBrush="#F2DFBE" BorderThickness="1" CornerRadius="8"
                                    Padding="10,8" Margin="0,11,0,0">
                                <TextBlock FontSize="11" Foreground="#8A5A00" TextWrapping="Wrap"
                                           LineHeight="17"
                                           Text="已连接，但电脑端已经一段时间没收到音频流。如果手机正在语音或视频通话，通话音频走的是通话免提通道（HFP），蓝牙媒体通道（A2DP）无法转发它，通话结束后通常会自动恢复。" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ActionButton" Content="连接" Width="96"
                                        Style="{StaticResource PrimaryButton}" Click="ActionButton_Click" />
                                <Button x:Name="RefreshButton" Content="刷新设备"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="Refresh_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 设备列表 -->
                    <Grid Margin="2,18,2,8">
                        <TextBlock Text="可接收的设备" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock x:Name="DeviceHint" Text="" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl x:Name="DeviceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="11"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        Padding="13,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="已配对 · 可接收音频" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="连接" Tag="{Binding}"
                                                Style="{StaticResource PrimaryButton}" Padding="14,6"
                                                VerticalAlignment="Center" Click="DeviceConnect_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyTip" Background="#FFFFFF" CornerRadius="11" Padding="14"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="没有找到可接收的设备。请先在「设置 → 蓝牙和其他设备」里把这台电脑和手机配对，配对完成后再点上面的「刷新设备」。" />
                    </Border>

                    <!-- 音量卡 -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Padding="16,13" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="音量" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />

                                <Slider x:Name="VolumeSlider" Grid.Column="1" Margin="14,0,12,0"
                                        Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                        VerticalAlignment="Center" Style="{StaticResource NiceSlider}"
                                        ValueChanged="VolumeSlider_ValueChanged" />

                                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="0%" FontSize="12"
                                           Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource InkBrush}" />

                                <Button x:Name="MuteButton" Grid.Column="3" Width="30" Height="26"
                                        Margin="6,0,0,0" Style="{StaticResource IconButton}"
                                        Click="Mute_Click">
                                    <TextBlock x:Name="MuteGlyph" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" />
                                </Button>
                            </Grid>

                            <TextBlock x:Name="OutputDeviceText" Text="输出到：—" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock FontSize="10.5" Foreground="#9AA1AA" Margin="0,4,0,0"
                                       TextWrapping="Wrap" LineHeight="16"
                                       Text="此滑块调的是电脑这端的输出音量；手机端的媒体音量属于另一层，两者叠加生效。" />
                        </StackPanel>
                    </Border>

                    <!-- 设置卡 -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <CheckBox x:Name="AutoReconnectSwitch" Style="{StaticResource Switch}"
                                      Content="断线后自动重连" Click="AutoReconnect_Click" />
                            <CheckBox x:Name="AutoConnectSwitch" Style="{StaticResource Switch}"
                                      Content="启动时自动连接上次的设备" Margin="0,11,0,0"
                                      Click="AutoConnect_Click" />
                            <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}"
                                      Content="开机自动启动" Margin="0,11,0,0" Click="Startup_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="2,12,2,0">
                        <TextBlock Text="所有连接过程都会写入日志，出问题可先看日志。" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Button Content="打开日志" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                Padding="10,4" FontSize="11" Click="OpenLog_Click" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
